# Copy to .env for local development.
# Dev database (also used by sqlx-cli and the compile-time checked query macros).
DATABASE_URL=sqlite://data/dev.db
BIND_ADDR=127.0.0.1:4000
# FRONTEND_DIR=apps/frontend/dist
# Only `true` or `false` is accepted. Set true when served over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# How long (ms) the total of an unfiltered list may be reused; 0 counts on every request.
LIST_COUNT_TTL_MS=1000
# SQLite only: checkpoint and truncate the WAL every this many ms (0 = off). Leave off
# where Litestream runs; for a database without Litestream under constant reads.
SQLITE_CHECKPOINT_INTERVAL_MS=0
# How many password hashes (Argon2, about 50-100 ms of CPU each) may run at once. A positive
# integer; unset, it is half the cores (at least 1), so a login burst cannot take every core.
# PASSWORD_HASH_PERMITS=2
# Database connections in the pool, on SQLite and Postgres alike. A positive integer; unset, 10.
# DATABASE_MAX_CONNECTIONS=20
LOG_FORMAT=pretty
RUST_LOG=info,library_web=debug,tower_http=info
# This node's name: 1-40 characters of a-z, 0-9 and '-'.
NODE_ID=local
