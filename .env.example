# Copy to .env for local development.
# Dev database (also used by sqlx-cli and the compile-time checked query macros).
DATABASE_URL=sqlite://data/dev.db
BIND_ADDR=127.0.0.1:4000
# FRONTEND_DIR=apps/frontend/dist
# Only `true` or `false` is accepted. Set true when served over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
LOG_FORMAT=pretty
RUST_LOG=info,library_web=debug,tower_http=info
# This node's name: 1-40 characters of a-z, 0-9 and '-'.
NODE_ID=local
